# ---------------------------------------------------------------------------
# Dependencies and build output - all regenerable, none belong in git
# ---------------------------------------------------------------------------
node_modules/
frontend/dist/
.vite/

# Python virtual environment (machine-specific)
.venv/
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Credentials - NEVER commit these
# ---------------------------------------------------------------------------
# Earthdata / HyP3 access is read from environment variables only. If you ever
# switch to a .netrc or .env, these keep it out of the repo.
.env
.env.*
.netrc
_netrc
*.pem
*.key

# ---------------------------------------------------------------------------
# HyP3 working state
# ---------------------------------------------------------------------------
# Downloaded Sentinel-1 products: hundreds of MB, re-downloadable from ASF.
backend/products/

# Job IDs tied to a specific Earthdata account. Not secret, but account-scoped
# and meaningless to anyone else - regenerated by `submit`.
backend/hyp3_state.json

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
*.swp
